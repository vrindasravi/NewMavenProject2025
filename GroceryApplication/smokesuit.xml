<suite name="GroceryApplication" parallel="tests" thread-count="5">
	<listeners>
		<listener class-name="listners.ExtenetReport"></listener>
		<listener class-name="listners.RetryListener"></listener>
	</listeners>
	<test name="Chrome Test">
		<parameter name="browser" value="chrome"></parameter>
		<groups>
			<run>
				<include name="smoke"></include>
			</run>
		</groups>
		<classes>
			<class name="testcase.LoginPageTest"></class>
		</classes>
	</test>
</suite>